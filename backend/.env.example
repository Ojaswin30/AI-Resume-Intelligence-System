# LLM Configuration (Default: Local Ollama or OpenAI-compatible local server like LM Studio / vLLM)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b

# Embedding Model (Sentence Transformers runs 100% locally on CPU)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# API Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=true
